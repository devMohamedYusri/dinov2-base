# Qdrant Cloud Cluster Configuration
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Collection Name in Qdrant (Default: furniture_catalog)
COLLECTION_NAME=furniture_catalog

# Optional Secret to protect internal maintenance endpoints (if any)
TRIGGER_SECRET=your_custom_secret_here
